# Copia este fichero a `.env` EN LA RAIZ del repo, en el servidor, y rellena
# todos los valores. Docker Compose lo lee automaticamente, sin flags.
# No reutilices los valores de desarrollo.

SECRET_KEY=genera-una-nueva-con-get_random_secret_key
DEBUG=False

# --- HTTPS -------------------------------------------------------------
# Direccion que sirve Caddy. Determina el modo de TLS:
#   midominio.com   -> certificado automatico de Let's Encrypt (produccion)
#   localhost       -> certificado de la CA interna de Caddy (pruebas locales)
#   :80             -> sin TLS, para cuando el proxy del proveedor ya lo hace
SITE_ADDRESS=midominio.com

# Activa redireccion a HTTPS, HSTS y cookies seguras en Django.
# Ponlo a False si SITE_ADDRESS es :80: con True, Django redirigiria a
# https:// y la app quedaria inaccesible al no haber nada escuchando ahi.
SECURE_SSL=True
# ----------------------------------------------------------------------

# Dominios desde los que se sirve la app, separados por comas
ALLOWED_HOSTS=midominio.com,www.midominio.com

# Origenes permitidos para CORS/CSRF, con esquema. Solo si el frontend
# se sirve desde un dominio distinto al backend.
CORS_ALLOWED_ORIGINS=https://midominio.com

DB_NAME=mindfulness
DB_USER=mindfulness
DB_PASSWORD=pon-aqui-una-contrasena-larga-y-aleatoria
DB_HOST=postgres
DB_PORT=5432
